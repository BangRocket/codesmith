# Discord
DISCORD_BOT_TOKEN=your_discord_bot_token_here
CODESMITH_CHANNEL_ID=  # Optional: restrict to specific channel ID

# Anthropic (passed to Claude Code processes)
# Optional if users authenticate with their own Claude Max/Pro subscription
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Sandbox Configuration
CODESMITH_WORKSPACE_BASE=/var/codesmith/workspaces
CODESMITH_SESSION_TIMEOUT=3600
CODESMITH_MAX_OUTPUT_CHARS=50000

# Code-server Configuration
# Set to false to disable code-server integration
CODE_SERVER_ENABLED=true
# Domain for code-server access (will use subdomains like 9001.code.example.com)
CODE_SERVER_DOMAIN=code.example.com
# Starting port for code-server instances (uses range PORT_BASE to PORT_BASE+999)
CODE_SERVER_PORT_BASE=9000

# Cloudflare Configuration (for setup script)
# API token with Zone:DNS:Edit permissions
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
# Zone ID from Cloudflare dashboard
CLOUDFLARE_ZONE_ID=your_zone_id_here
# Base domain (e.g., example.com)
CLOUDFLARE_DOMAIN=example.com
