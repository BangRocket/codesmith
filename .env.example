# Discord Bot Configuration (required)
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_APP_ID=your_discord_application_id

# Optional: Restrict bot to specific channel
# CODESMITH_CHANNEL_ID=your_channel_id

# Optional: Global Anthropic API key (fallback if users don't have OAuth)
# If not set, users must authenticate via /cc login with their Claude Max/Pro subscription
# ANTHROPIC_API_KEY=your_anthropic_api_key

# Optional: Custom workspace directory (default: ~/.codesmith/workspaces)
# CODESMITH_WORKSPACE_BASE=/var/codesmith/workspaces

# Optional: Session timeout in milliseconds (default: 3600000 = 1 hour)
# CODESMITH_SESSION_TIMEOUT=3600000

# Optional: Default model (default: sonnet)
# CODESMITH_DEFAULT_MODEL=sonnet
